# Use unquoted values and replace the example address and serial.
GARO_CHARGER_HOST=192.168.1.100
GARO_CHARGER_PORT=8080
GARO_CHARGER_SERIAL=1234567

# Optional host port for Docker Compose.
# GARO_DASHBOARD_PORT=8765

# Optional dashboard refresh interval in seconds for Docker Compose.
# GARO_DASHBOARD_REFRESH_SECONDS=60

# Optional time zone and collection interval for the Docker energy archive.
# GARO_ENERGY_TIMEZONE=UTC
# GARO_ENERGY_INTERVAL_SECONDS=3600
