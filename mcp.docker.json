{
  "mcpServers": {
    "garo": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "--pull=never",
        "-i",
        "--init",
        "--read-only",
        "--cap-drop=ALL",
        "--security-opt=no-new-privileges:true",
        "--env-file", "/absolute/path/to/garo/.env",
        "garo:local",
        "mcp"
      ]
    }
  }
}
